{
  "name": "dsh-sensenova-skills",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: bridge OpenSenseNova/SenseNova-Skills (MIT) agent skills into DSH — sync upstream skill packs, browse and load SKILL.md instructions so the agent can drive SenseNova office skills (PPT, infographics, deep research, data analysis).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-upstream.js",
    "build:client": "node client/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sensenova",
    "agent-skills",
    "skill",
    "sn-infographic",
    "sn-ppt-standard",
    "sn-deep-research"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JE668/dsh-sensenova-skills.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}